// Pulse — coordination store only. Nothing here is durable user data:
// rows are deleted on leave, on staleness, or after a signal is delivered.
// Chat text and video are NOT modeled — they ride WebRTC peer-to-peer and
// never reach the server.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Presence {
  id              String   @id // public client-generated session uuid
  sessionHash     String // SHA-256 of the private per-session capability token
  lat             Float // ALREADY privacy-offset coords (raw is never stored)
  lng             Float
  busy            Boolean  @default(false) // true while reserved or connected
  peerId          String? // server-owned pairing, never accepted from the client
  connectionState String? // pending | connected
  isInitiator     Boolean  @default(false)
  lastSeen        DateTime

  @@index([lastSeen])
  @@index([peerId])
}

model Signal {
  // Mailbox for connection requests + WebRTC signaling only.
  id        String   @id @default(uuid())
  toId      String // recipient session id
  fromId    String // sender session id
  type      String // request | accept | decline | offer | answer | ice | end
  payload   String? // JSON string (SDP / ICE candidate)
  createdAt DateTime @default(now())

  @@index([toId])
}

model RateLimit {
  key       String   @id // scope + one-way hash of the requester IP
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}
